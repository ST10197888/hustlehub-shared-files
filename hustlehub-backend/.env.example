# Server configuration
PORT=5000
HTTPS_ENABLED=false

CLIENT_ORIGIN=http://localhost:5173

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# MongoDB - local development example
MONGODB_URI=mongodb://127.0.0.1:27017/hustlehub
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/hustlehub_test

# Optional HTTPS certificate configuration
# Configure these when HTTPS_ENABLED=true
SSL_PFX_PATH=certs/cert.pfx
SSL_PFX_PASSPHRASE=replace_with_your_certificate_passphrase


# Optional Better Stack cloud logging
# Enable only after configuring your source token and HTTPS ingesting URL.
BETTER_STACK_ENABLED=false
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_URL=